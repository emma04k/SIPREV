# SIPREV environment template
# Copy to .env for Docker Compose interpolation, or to your deployment provider's
# environment settings. Do not commit real secrets or Neon credentials.

# Docker Compose local demo/dev defaults only. These credentials are intentionally
# non-production and match the local postgres service in docker-compose.yml.
# If you change POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB below, also update
# DATABASE_URL so the app service can connect to the db service by its Compose name.
POSTGRES_USER="siprev"
POSTGRES_PASSWORD="siprev_dev_password"
POSTGRES_DB="siprev"
POSTGRES_PORT="5432"
APP_PORT="3000"
DATABASE_URL="postgresql://siprev:siprev_dev_password@db:5432/siprev?schema=public"

# Production/Neon example format for deployment settings only:
# DATABASE_URL="postgresql://USER:***@HOST/siprev?sslmode=require"

# Public canonical app URL used for metadata and Auth.js callbacks.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"

# Phase 3 Auth.js local demo secrets.
# These explicit placeholders are demo-only / no producción. Generate real
# deployment values outside the repo with: npx auth secret
NEXTAUTH_SECRET="siprev-phase3-local-demo-only-secret-not-for-production"
AUTH_SECRET="siprev-phase3-local-demo-only-secret-not-for-production"

# Phase 3 local demo credential reference only for precreated seed accounts.
# The app/seed code intentionally does not read this as a runtime secret override.
# Do not reuse this password outside Docker/local educational demos.
SIPREV_DEMO_PASSWORD="SiprevDemo2026!"
